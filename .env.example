# ===========================================
# Configuración del Servidor
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# Base de Datos MongoDB
# ===========================================
# Para desarrollo local:
MONGO_URI=mongodb://localhost:27017/tienda-deportes

# Para MongoDB Atlas (producción):
# MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tienda-deportes?retryWrites=true&w=majority

# ===========================================
# JWT (JSON Web Tokens)
# ===========================================
# IMPORTANTE: Cambiar en producción por un secreto seguro
JWT_SECRET=tu_secreto_jwt_muy_seguro_cambiar_en_produccion
JWT_EXPIRE=7d

# ===========================================
# Notas importantes
# ===========================================
# 1. Nunca subir el archivo .env al repositorio
# 2. Usar variables de entorno del sistema en producción
# 3. Las transacciones MongoDB requieren un Replica Set
#    - En MongoDB Atlas está habilitado por defecto
#    - En local, configurar replica set o usar standalone para desarrollo
